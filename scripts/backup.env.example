# Copia este archivo a scripts/backup.env. No se sube a Git.

# Dónde se guardan las copias. Mejor fuera de la máquina:
#   un disco USB:          /mnt/copias/nexus
#   otro equipo por SFTP:  sftp:usuario@192.168.0.50:/copias/nexus
#   Backblaze B2 (10 GB gratis): b2:nombre-del-bucket:nexus (más B2_ACCOUNT_ID y B2_ACCOUNT_KEY)
RESTIC_REPOSITORY=/mnt/copias/nexus

# Archivo con la contraseña que cifra las copias (chmod 600). Guárdala también fuera del servidor:
# sin ella las copias no se pueden abrir.
RESTIC_PASSWORD_FILE=/root/.restic-nexus
